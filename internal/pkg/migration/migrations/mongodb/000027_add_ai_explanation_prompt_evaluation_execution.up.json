[
  {
    "createIndexes": "ai_explanation_prompt_evaluations",
    "indexes": [
      {
        "key": { "active_release_key": 1 },
        "name": "uk_ai_explanation_prompt_evaluation_active_release",
        "unique": true,
        "partialFilterExpression": { "active_release_key": { "$type": "string" } }
      },
      {
        "key": { "active_execution_org_key": 1 },
        "name": "uk_ai_explanation_prompt_evaluation_active_org_execution",
        "unique": true,
        "partialFilterExpression": { "active_execution_org_key": { "$type": "string" } }
      },
      {
        "key": { "status": 1, "execution.phase": 1, "execution.lease_expires_at": 1, "domain_id": 1 },
        "name": "idx_ai_explanation_prompt_evaluation_expired_lease",
        "partialFilterExpression": {
          "status": "collecting",
          "execution.phase": "prepared",
          "execution.lease_expires_at": { "$type": "date" }
        }
      }
    ]
  },
  { "create": "ai_explanation_prompt_evaluation_daily_budgets" },
  {
    "createIndexes": "ai_explanation_prompt_evaluation_daily_budgets",
    "indexes": [
      {
        "key": { "org_id": 1, "budget_day": 1 },
        "name": "uk_ai_explanation_prompt_evaluation_budget_org_day",
        "unique": true
      },
      {
        "key": { "reservations.run_id": 1 },
        "name": "uk_ai_explanation_prompt_evaluation_budget_run",
        "unique": true,
        "sparse": true
      }
    ]
  }
]
