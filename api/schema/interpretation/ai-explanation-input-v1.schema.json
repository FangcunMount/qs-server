{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FangcunMount/qs-server/main/api/schema/interpretation/ai-explanation-input-v1.schema.json",
  "title": "AIExplanationInput v1",
  "description": "Server-side immutable input snapshot for one manually triggered AI explanation. Only context and facts are sent to the model provider; source and profile remain server-side audit metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "profile",
    "context",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-explanation-input/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-only provenance. This object MUST NOT be sent to the model provider.",
      "required": [
        "report_id",
        "outcome_id",
        "report_type",
        "report_template_version",
        "content_schema_version",
        "builder_identity",
        "generated_at"
      ],
      "properties": {
        "report_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "report_type": {
          "const": "standard"
        },
        "report_template_version": {
          "$ref": "#/$defs/versionString"
        },
        "content_schema_version": {
          "$ref": "#/$defs/versionString"
        },
        "builder_identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exact published profile used to assemble and validate this input.",
      "required": [
        "profile_id",
        "profile_version",
        "profile_fingerprint"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "profile_version": {
          "$ref": "#/$defs/versionString"
        },
        "profile_fingerprint": {
          "$ref": "#/$defs/sha256Fingerprint"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "audience",
        "locale",
        "personalization_scope",
        "focus_areas"
      ],
      "properties": {
        "scope": {
          "const": "current_assessment_only"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "maxLength": 35
        },
        "personalization_scope": {
          "enum": [
            "assessment_result_only",
            "assessment_result_and_focus_areas"
          ]
        },
        "focus_areas": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "personalization_scope": {
                "const": "assessment_result_only"
              }
            },
            "required": [
              "personalization_scope"
            ]
          },
          "then": {
            "properties": {
              "focus_areas": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "personalization_scope": {
                "const": "assessment_result_and_focus_areas"
              }
            },
            "required": [
              "personalization_scope"
            ]
          },
          "then": {
            "properties": {
              "focus_areas": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Allowlisted facts copied from the immutable standard report and its EvaluationOutcome provenance.",
      "required": [
        "runtime",
        "model",
        "overall_result",
        "dimensions",
        "standard_suggestions",
        "model_result"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_kind"
          ],
          "properties": {
            "decision_kind": {
              "$ref": "#/$defs/decisionKind"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "algorithm",
            "code",
            "version",
            "title"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/modelKind"
            },
            "algorithm": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "code": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "title": {
              "$ref": "#/$defs/plainText"
            }
          }
        },
        "overall_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_score",
            "level",
            "standard_conclusion"
          ],
          "properties": {
            "primary_score": {
              "anyOf": [
                {
                  "$ref": "#/$defs/scoreValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "level": {
              "anyOf": [
                {
                  "$ref": "#/$defs/resultLevel"
                },
                {
                  "type": "null"
                }
              ]
            },
            "standard_conclusion": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "^[^<>]*$"
            }
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        },
        "standard_suggestions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/standardSuggestion"
          }
        },
        "model_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/modelResult"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "versionString": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "sha256Fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^<>]*$"
    },
    "audience": {
      "enum": [
        "participant"
      ]
    },
    "modelKind": {
      "enum": [
        "scale"
      ]
    },
    "decisionKind": {
      "enum": [
        "score_range"
      ]
    },
    "scoreValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "label",
        "max"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^<>]*$"
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "resultLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "severity"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/plainText"
        },
        "severity": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "normContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score_kind",
        "benchmark",
        "table_version",
        "form_variant",
        "min_age_months",
        "max_age_months",
        "gender"
      ],
      "properties": {
        "score_kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "benchmark": {
          "type": "number"
        },
        "table_version": {
          "$ref": "#/$defs/versionString"
        },
        "form_variant": {
          "type": "string",
          "maxLength": 64
        },
        "min_age_months": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_months": {
          "type": "integer",
          "minimum": 0
        },
        "gender": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "code",
        "kind",
        "name",
        "role",
        "parent_ref",
        "hierarchy_level",
        "sort_order",
        "raw_score",
        "derived_scores",
        "level",
        "norm_context",
        "standard_description",
        "standard_suggestion_refs"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^dimension:[^\\s]+$",
          "maxLength": 265
        },
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "factor",
            "pole",
            "trait",
            "index",
            "ability"
          ]
        },
        "name": {
          "$ref": "#/$defs/plainText"
        },
        "role": {
          "type": "string",
          "maxLength": 64
        },
        "parent_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^dimension:[^\\s]+$",
          "maxLength": 265
        },
        "hierarchy_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0
        },
        "raw_score": {
          "$ref": "#/$defs/scoreValue"
        },
        "derived_scores": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/scoreValue"
          }
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/resultLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "norm_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/normContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard_description": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^<>]*$"
        },
        "standard_suggestion_refs": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^suggestion:[^\\s]+$",
            "maxLength": 266
          }
        }
      }
    },
    "standardSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "category",
        "content",
        "dimension_refs"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^suggestion:[^\\s]+$",
          "maxLength": 266
        },
        "category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content": {
          "$ref": "#/$defs/plainText"
        },
        "dimension_refs": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dimension:[^\\s]+$",
            "maxLength": 265
          }
        }
      }
    },
    "modelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type_code",
        "type_name",
        "one_liner",
        "match_percent",
        "commentary"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type_name": {
          "$ref": "#/$defs/plainText"
        },
        "one_liner": {
          "$ref": "#/$defs/plainText"
        },
        "match_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "commentary": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^<>]*$"
        }
      }
    }
  }
}
