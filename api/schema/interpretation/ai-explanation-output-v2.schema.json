{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FangcunMount/qs-server/main/api/schema/interpretation/ai-explanation-output-v2.schema.json",
  "title": "MBTI three-topic AI explanation output v2",
  "description": "Finite MBTI content contract. Report facts, general reference material and exploratory applications remain distinct. Existence, applicability and semantic support of references require separate validation against frozen evidence. Source titles and URLs are supplied by the server from frozen material, never by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_contract_version",
    "summary",
    "sections",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-explanation-output/v2"
    },
    "scene_contract_version": {
      "const": "mbti-single-assessment/v2"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "basis",
        "evidence_refs"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "basis": {
          "const": "report_fact"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reportRef"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            },
            {
              "properties": {
                "topic": {
                  "const": "personality"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            },
            {
              "properties": {
                "topic": {
                  "const": "career"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            },
            {
              "properties": {
                "topic": {
                  "const": "relationships"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/shortText"
      }
    }
  },
  "$defs": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "allOf": [
        {
          "pattern": "^[^<>]*$"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "allOf": [
        {
          "pattern": "^[^<>]*$"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "allOf": [
        {
          "pattern": "^[^<>]*$"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "reportRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "dimension"
            },
            "ref": {
              "type": "string",
              "pattern": "^dimension:(EI|SN|TF|JP)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "overall_result"
            },
            "ref": {
              "const": "overall_result"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "model_result"
            },
            "ref": {
              "const": "model_result"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "standard_suggestion"
            },
            "ref": {
              "type": "string",
              "maxLength": 266,
              "pattern": "^suggestion:[^\\s]+$"
            }
          }
        }
      ]
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "content",
        "basis",
        "evidence_refs",
        "reference_refs"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/title"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "basis": {
          "enum": [
            "report_fact",
            "general_reference",
            "exploration"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reportRef"
          }
        },
        "reference_refs": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^reference:[a-z][a-z0-9._-]{0,127}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "report_fact"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "reference_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "enum": [
                  "general_reference",
                  "exploration"
                ]
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "reference_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "basis",
        "evidence_refs",
        "reference_refs"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/shortText"
        },
        "basis": {
          "const": "exploration"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reportRef"
          }
        },
        "reference_refs": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^reference:[a-z][a-z0-9._-]{0,127}$"
          },
          "minItems": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "goal",
        "steps",
        "basis",
        "evidence_refs",
        "reference_refs"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/title"
        },
        "goal": {
          "$ref": "#/$defs/shortText"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        },
        "basis": {
          "const": "exploration"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reportRef"
          }
        },
        "reference_refs": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^reference:[a-z][a-z0-9._-]{0,127}$"
          },
          "minItems": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "insights",
        "reflection_questions",
        "actions"
      ],
      "properties": {
        "topic": {
          "enum": [
            "personality",
            "career",
            "relationships"
          ]
        },
        "insights": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/insight"
          }
        },
        "reflection_questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/reflection"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    }
  }
}
